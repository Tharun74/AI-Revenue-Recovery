# Razorpay TEST MODE credentials — get these from
# https://dashboard.razorpay.com/app/keys (make sure "Test Mode" toggle is ON)
# The client refuses to start on anything that isn't an rzp_test key.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Fireworks AI key — used by the diagnose stage.
# Optional: without it, diagnosis falls back to the deterministic rule path and
# the report records llm_used=false. Nothing else changes.
# https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=fw_xxxxxxxxxxxxxxxxxxxxxxxx
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3

# Contact policy. These two are the whole of "don't harass the customer":
# never more than MAX_RETRY_ATTEMPTS touches, never two inside the cooldown.
MAX_RETRY_ATTEMPTS=3
RETRY_COOLDOWN_HOURS=6

# Seed for the settlement outcome model, so the "modeled" column of the report is
# reproducible run to run for a given batch.
OUTCOME_MODEL_SEED=42

# Append-only audit trail. AUDIT_FSYNC=true flushes every entry to disk; turn it
# off only if you do not care about losing the tail of the log on a hard crash.
# AUDIT_LOG_PATH is left unset on purpose — the default is anchored to the project
# root, whereas a relative value here would follow whatever directory you ran from.
AUDIT_FSYNC=true
